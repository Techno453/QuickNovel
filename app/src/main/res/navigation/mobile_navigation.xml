<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            xmlns:tools="http://schemas.android.com/tools"
            android:id="@+id/mobile_navigation"
            app:startDestination="@+id/navigation_download">
    <!-- Browse tab: per-language source cards with popular rails, and the All sources feed
         (docs/browse.md). Each source's own page is navigation_mainpage. -->
    <fragment
            android:id="@+id/navigation_browse"
            android:name="com.lagradost.quicknovel.ui.browse.BrowseFragment"
            android:label="@string/title_browse"
            android:layout_height="match_parent">
    </fragment>
    <fragment
            android:id="@+id/navigation_search"
            android:name="com.lagradost.quicknovel.ui.search.SearchFragment"
            android:label="@string/title_search"
            android:layout_height="match_parent"
            tools:layout="@layout/fragment_search">
    </fragment>
    <fragment
            android:id="@+id/navigation_download"
            android:name="com.lagradost.quicknovel.ui.download.DownloadFragment"
            android:label="@string/title_download"
            android:layout_height="match_parent"
            tools:layout="@layout/fragment_downloads">
    </fragment>
    <fragment
            android:id="@+id/navigation_settings"
            android:name="com.lagradost.quicknovel.ui.settings.SettingsFragment"
            android:label="@string/title_download"
            android:layout_height="match_parent">
    </fragment>
    <fragment
            android:id="@+id/navigation_mainpage"
            android:name="com.lagradost.quicknovel.ui.mainpage.MainPageFragment"
            android:label="@string/title_download"
            android:layout_height="match_parent">
    </fragment>
    <fragment
            android:id="@+id/navigation_history"
            android:name="com.lagradost.quicknovel.ui.history.HistoryFragment"
            android:label="@string/title_download"
            android:layout_height="match_parent">
    </fragment>

    <fragment
            android:id="@+id/navigation_results"
            android:name="com.lagradost.quicknovel.ui.result.ResultFragment2"
            android:layout_height="match_parent">
    </fragment>

    <fragment
            android:id="@+id/navigation_glossary"
            android:name="com.lagradost.quicknovel.ui.glossary.GlossaryFragment"
            android:label="Glossary"
            android:layout_height="match_parent">
    </fragment>


    <action
            android:id="@+id/global_to_navigation_results"
            app:destination="@id/navigation_results"
            app:enterAnim="@anim/enter_anim"
            app:exitAnim="@anim/exit_anim"
            app:popEnterAnim="@anim/enter_anim"
            app:popExitAnim="@anim/exit_anim">
        <argument
                android:name="url"
                app:argType="string" />
        <argument
                android:name="apiName"
                app:argType="string" />
        <argument
                android:name="startAction"
                android:defaultValue="0"
                app:argType="integer" />
    </action>

    <action
            android:id="@+id/global_to_navigation_glossary"
            app:destination="@id/navigation_glossary"
            app:enterAnim="@anim/enter_anim"
            app:exitAnim="@anim/exit_anim"
            app:popEnterAnim="@anim/enter_anim"
            app:popExitAnim="@anim/exit_anim">
        <argument
                android:name="novel_id"
                app:argType="string" />
        <argument
                android:name="novel_name"
                app:argType="string" />
    </action>

    <action
            android:id="@+id/global_to_navigation_mainpage"
            app:destination="@id/navigation_mainpage"
            app:enterAnim="@anim/enter_anim"
            app:exitAnim="@anim/exit_anim"
            app:popEnterAnim="@anim/enter_anim"
            app:popExitAnim="@anim/exit_anim">
        <argument
                android:name="url"
                app:argType="string" />
        <argument
                android:name="mainCategory"
                app:argType="integer" />
        <argument
                android:name="orderBy"
                app:argType="integer" />
        <argument
                android:name="tag"
                app:argType="integer" />
    </action>
</navigation>