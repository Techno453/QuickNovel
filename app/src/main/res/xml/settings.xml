<?xml version="1.0" encoding="utf-8"?>

<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory />
    <PreferenceCategory
            android:key="search"
            android:title="@string/search"
            app:isPreferenceVisible="true">
        <SwitchPreference
                android:icon="@drawable/search_icon_white"
                app:key="advanced_search"
                android:title="@string/advanced_search"
                android:summary="@string/advanced_search_desc"
                app:defaultValue="true" />
        <Preference
                app:icon="@drawable/ic_baseline_cloud_24"
                android:key="@string/search_providers_list_key"
                android:title="@string/search_providers"
                app:useSimpleSummaryProvider="true" />
        <Preference
                android:key="@string/download_path_key"
                android:title="@string/download_path_pref"
                android:icon="@drawable/netflix_download" />
        <!--<ListPreference
                app:icon="@drawable/ic_baseline_grid_view_24"
                android:key="@string/grid_format_key"
                android:title="Display Mode"
                app:defaultValue="grid"
                app:useSimpleSummaryProvider="true"
                android:entries="@array/GridFormat"
                android:entryValues="@array/GridFormatData" />-->
        <Preference
                android:icon="@drawable/ic_baseline_language_24"
                android:key="@string/provider_lang_key"
                android:title="@string/provider_lang_settings" />

        <Preference
                android:icon="@drawable/ic_baseline_language_24"
                android:key="@string/locale_key"
                android:title="@string/locale_settings" />
    </PreferenceCategory>


    <PreferenceCategory
            android:key="general"
            android:title="@string/general"
            app:isPreferenceVisible="true">
        <!--
        <ListPreference
                app:icon="@drawable/ic_baseline_cloud_24"
                android:key="@string/provider_list_key"
                android:title="Active Provider"
                app:useSimpleSummaryProvider="true" />-->
        <Preference
                app:icon="@drawable/ic_baseline_star_24"
                android:key="@string/rating_format_key"
                android:title="@string/rating_format"
                app:defaultValue="star"
                app:useSimpleSummaryProvider="true" />
        <Preference
                app:icon="@drawable/ic_baseline_grid_view_24"
                android:key="@string/download_format_key"
                android:title="@string/library_display_mode"
                app:defaultValue="list"
                app:useSimpleSummaryProvider="true"
                android:entries="@array/DownloadGridFormat"
                android:entryValues="@array/DownloadGridFormatData" />
        <SwitchPreference
                app:key="@string/auto_update_key"
                android:title="@string/show_app_updates"
                android:summary="@string/show_app_updates_desc"
                app:defaultValue="true"
                android:icon="@drawable/ic_baseline_notifications_active_24" />
        <SwitchPreference
                app:key="@string/external_reader_key"
                android:title="@string/external_reader"
                android:summary="@string/external_reader_desc"
                app:defaultValue="true"
                android:icon="@drawable/ic_baseline_menu_book_24" />
        <SwitchPreference
                app:key="@string/remove_external_key"
                android:title="@string/remove_bloat"
                android:summary="@string/remove_bloat_desc"
                app:defaultValue="true"
                android:icon="@drawable/ic_baseline_edit_24" />

        <Preference
                app:key="@string/theme_key"
                android:title="@string/theme"
                android:icon="@drawable/ic_baseline_color_lens_24"
                app:useSimpleSummaryProvider="true" />
        <Preference
                app:key="@string/primary_color_key"
                android:title="@string/primary_color_settings"
                android:icon="@drawable/ic_baseline_color_lens_24"
                app:useSimpleSummaryProvider="true" />

        <Preference
                android:title="@string/check_for_update"
                app:key="@string/manual_check_update_key"
                app:icon="@drawable/ic_baseline_system_update_24" />
        <Preference
                android:icon="@drawable/baseline_save_as_24"
                android:key="@string/backup_key"
                android:title="@string/backup_settings" />

        <Preference
                android:icon="@drawable/baseline_restore_page_24"
                android:key="@string/restore_key"
                android:title="@string/restore_settings" />
        <Preference
                android:icon="@drawable/baseline_description_24"
                android:key="@string/show_logcat_key"
                android:title="@string/show_log_cat" />
    </PreferenceCategory>

    <PreferenceCategory
            android:key="translation"
            android:title="AI Translation (Chinese / Japanese / Korean → English)"
            app:isPreferenceVisible="true">

        <Preference
                android:icon="@drawable/ic_baseline_translate_24"
                android:key="openai_api_key_pref"
                android:title="API Key"
                android:summary="API key for the OpenAI-compatible translation backend" />

        <Preference
                android:icon="@drawable/ic_baseline_translate_24"
                android:key="openai_base_url_pref"
                android:title="API Base URL"
                android:summary="https://api.openai.com/v1" />

        <Preference
                android:icon="@drawable/ic_baseline_translate_24"
                android:key="openai_model_pref"
                android:title="Translation Model"
                android:summary="gpt-4o-mini (fast, cheap), gpt-4o (best quality) or a custom model" />

        <SwitchPreference
                android:icon="@drawable/ic_baseline_translate_24"
                android:key="translation_enabled_pref"
                android:title="Enable Translation UI"
                android:summary="Show Translate button for Chinese, Japanese and Korean sources"
                app:defaultValue="true" />

        <SwitchPreference
                android:icon="@drawable/ic_baseline_translate_24"
                android:key="translate_on_demand_pref"
                android:title="Translate on demand while reading"
                android:summary="Translate untranslated chapters with AI when you open them (uses your API key)"
                app:defaultValue="false" />

        <SwitchPreference
                android:icon="@drawable/ic_baseline_translate_24"
                android:key="gtranslate_titles_pref"
                android:title="Auto-translate Titles &amp; Synopses"
                android:summary="Use Google Translate (free) for search titles, chapter names, and synopses"
                app:defaultValue="false" />

        <SwitchPreference
                android:icon="@drawable/search_icon"
                android:key="translate_search_queries_pref"
                android:title="Translate search queries"
                android:summary="Search Chinese, Japanese and Korean sources with your query translated into their language"
                app:defaultValue="true" />

        <SwitchPreference
                android:icon="@drawable/search_icon"
                android:key="ai_search_queries_pref"
                android:dependency="translate_search_queries_pref"
                android:title="Use AI for search queries"
                android:summary="Translate queries with the AI model instead of Google Translate (better for novel titles)"
                app:defaultValue="false" />

    </PreferenceCategory>

    <PreferenceCategory
            android:key="extra"
            android:title="@string/info"
            app:isPreferenceVisible="true">

        <Preference
                android:title="Github"
                android:icon="@drawable/ic_github_logo"
                app:summary="https://github.com/LagradOst/QuickNovel">
            <intent
                    android:action="android.intent.action.VIEW"
                    android:data="https://github.com/LagradOst/QuickNovel" />
        </Preference>

        <Preference
                android:title="Anime and Movie app by the same devs"
                android:icon="@drawable/ic_github_logo"
                app:summary="https://github.com/recloudstream/cloudstream">
            <intent
                    android:action="android.intent.action.VIEW"
                    android:data="https://github.com/recloudstream/cloudstream" />
        </Preference>

        <Preference
                android:title="Join Discord"
                android:icon="@drawable/ic_baseline_discord_24"
                app:summary="https://discord.gg/5Hus6fM">
            <intent
                    android:action="android.intent.action.VIEW"
                    android:data="https://discord.gg/5Hus6fM" />
        </Preference>
    </PreferenceCategory>
</PreferenceScreen>
