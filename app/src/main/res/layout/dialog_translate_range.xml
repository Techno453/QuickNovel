<?xml version="1.0" encoding="utf-8"?>
<!-- Translate chapters: range, estimate, when (now / overnight), glossary. Scrolls on short screens
     (a foldable's cover screen). Styles in styles_translate.xml. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/TranslateTextField"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/tr_dialog_from">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/range_from"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/TranslateTextField"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:hint="@string/tr_dialog_to">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/range_to"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/range_available"
        style="@style/TranslateNote" />

    <TextView
        android:id="@+id/already_translated"
        style="@style/TranslateNote"
        android:visibility="gone" />

    <TextView
        android:id="@+id/chapters_to_translate"
        style="@style/TranslateBody"
        android:layout_marginTop="12dp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/estimated_cost"
        style="@style/TranslateNote" />

    <TextView
        android:id="@+id/month_spend"
        style="@style/TranslateNote"
        android:visibility="gone" />

    <CheckBox
        android:id="@+id/retranslate_stale"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="?attr/textColor"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        style="@style/TranslateSectionLabel"
        android:text="@string/tr_dialog_when" />

    <RadioGroup
        android:id="@+id/translate_mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/mode_now"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/translate_mode_now"
            android:textColor="?attr/textColor" />

        <RadioButton
            android:id="@+id/mode_overnight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/translate_mode_batch"
            android:textColor="?attr/textColor" />
    </RadioGroup>

    <TextView
        android:id="@+id/mode_note"
        style="@style/TranslateNote"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/batch_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/batch_status"
            style="@style/TranslateBody" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/batch_cancel"
                style="@style/TranslateTextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/batch_cancel"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/batch_translate_rest"
                style="@style/TranslateTextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/batch_translate_rest"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        style="@style/TranslateSectionLabel"
        android:text="@string/tr_dialog_glossary" />

    <TextView
        android:id="@+id/bible_status"
        style="@style/TranslateBody" />

    <TextView
        android:id="@+id/bible_analyze_hint"
        style="@style/TranslateNote"
        android:text="@string/bible_analyze_hint"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/bible_analyze_button"
        style="@style/TranslateOutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/bible_analyze_button"
        android:visibility="gone"
        app:icon="@drawable/ic_analyze_24" />

</LinearLayout>

</ScrollView>
