<?xml version="1.0" encoding="utf-8"?>
<!-- Gaze test screen (GazeTestActivity, docs/gaze-test.md). Every part above and below the
     passage has a fixed height and only changes visibility (INVISIBLE, never GONE), so the
     passage keeps its line breaks from calibration to the end of a trial. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/gaze_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/readerBackground"
    android:orientation="vertical">

    <TextView
        android:id="@+id/gaze_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:lines="5"
        android:paddingHorizontal="12dp"
        android:paddingTop="8dp"
        android:textColor="@color/readerTextColor"
        android:textSize="11sp"
        tools:text="Starting…" />

    <FrameLayout
        android:id="@+id/gaze_page"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/gaze_passage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:lineSpacingMultiplier="1.3"
            android:paddingHorizontal="20dp"
            android:paddingVertical="12dp"
            android:textColor="@color/readerTextColor"
            android:textSize="18sp" />

        <View
            android:id="@+id/gaze_dot"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:visibility="invisible" />

        <androidx.camera.view.PreviewView
            android:id="@+id/gaze_preview"
            android:layout_width="72dp"
            android:layout_height="96dp"
            android:layout_gravity="top|end"
            android:layout_margin="8dp" />
    </FrameLayout>

    <com.lagradost.quicknovel.gaze.GazePlotView
        android:id="@+id/gaze_plot"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginHorizontal="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="4dp">

        <Button
            android:id="@+id/gaze_calibrate"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Calibrate" />

        <Button
            android:id="@+id/gaze_read"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Read" />

        <Button
            android:id="@+id/gaze_next"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Next" />

        <Button
            android:id="@+id/gaze_paste"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Paste" />

        <Button
            android:id="@+id/gaze_share"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Share" />
    </LinearLayout>
</LinearLayout>
